{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        "meta": {
          ".read": "auth != null"
        },
        "seats": {
          ".read": "auth != null",
          "$i": {
            "online": {
              ".write": "auth != null && data.parent().child('uid').val() === auth.uid",
              ".validate": "newData.isBoolean()"
            },
            "offlineAt": {
              ".write": "auth != null && data.parent().child('uid').val() === auth.uid",
              ".validate": "newData.isNumber() && newData.val() <= now"
            }
          }
        },
        "public": {
          ".read": "auth != null"
        },
        "private": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },
        "secret": {
          ".read": false
        }
      }
    },
    "live": {
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[A-Z2-9]{4}$/)",
        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['hostUid', 'kind', 'createdAt']) && newData.child('kind').val().matches(/^(buzzer|vote|speed-draw|secret-roles|adventure)$/)"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('live').child($code).child('meta').child('hostUid').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 24)"
          }
        },
        "state": {
          ".write": "auth != null && root.child('live').child($code).child('meta').child('hostUid').val() === auth.uid",
          "round": {
            ".validate": "newData.isNumber()"
          },
          "locked": {
            ".validate": "newData.isBoolean()"
          }
        },
        "buzz": {
          ".write": "auth != null && root.child('live').child($code).child('meta').child('hostUid').val() === auth.uid",
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && (root.child('live').child($code).child('state').child('round').val() + '') === $round && root.child('live').child($code).child('state').child('locked').val() !== true",
              ".validate": "newData.child('t').val() === now"
            }
          }
        },
        "poll": {
          ".write": "auth != null && root.child('live').child($code).child('meta').child('hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['id', 'question', 'options', 'open'])"
        },
        "votes": {
          ".write": "auth != null && root.child('live').child($code).child('meta').child('hostUid').val() === auth.uid",
          "$pollId": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('live').child($code).child('poll').child('id').val() === $pollId && root.child('live').child($code).child('poll').child('open').val() === true",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 12"
            }
          }
        },
        "draws": {
          ".write": "auth != null && root.child('live').child($code).child('meta').child('hostUid').val() === auth.uid",
          "$game": {
            "$uid": {
              "$i": {
                ".write": "auth != null && auth.uid === $uid && (root.child('live').child($code).child('state').child('game').val() + '') === $game && now < root.child('live').child($code).child('state').child('drawEnd').val() + 10000",
                ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 120000"
              }
            }
          }
        },
        "answers": {
          ".write": "auth != null && root.child('live').child($code).child('meta').child('hostUid').val() === auth.uid",
          "$game": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && (root.child('live').child($code).child('state').child('game').val() + '') === $game && now < root.child('live').child($code).child('state').child('orderEnd').val() + 3000 && root.child('live').child($code).child('state').child('reveal').val() !== true",
              ".validate": "newData.hasChildren(['order']) && newData.child('order').isString() && newData.child('order').val().length <= 64",
              "done": {
                ".validate": "newData.isBoolean()"
              },
              "order": {
                ".validate": true
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "rolls": {
          ".write": "auth != null && root.child('live').child($code).child('meta').child('hostUid').val() === auth.uid",
          "$id": {
            ".write": "auth != null && !data.exists() && (root.child('live').child($code).child('meta').child('hostUid').val() === auth.uid || root.child('live').child($code).child('players').child(auth.uid).exists())",
            ".validate": "newData.hasChildren(['uid', 'total', 't']) && newData.child('uid').val() === auth.uid && newData.child('total').isNumber() && newData.child('t').val() === now && (!newData.child('label').exists() || (newData.child('label').isString() && newData.child('label').val().length <= 80))"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "liveRoles": {
      "$code": {
        ".validate": "$code.matches(/^[A-Z2-9]{4}$/)",
        ".write": "auth != null && root.child('live').child($code).child('meta').child('hostUid').val() === auth.uid",
        ".read": "auth != null && root.child('live').child($code).child('meta').child('hostUid').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "liveInbox": {
      "$code": {
        ".validate": "$code.matches(/^[A-Z2-9]{4}$/)",
        ".read": "auth != null && root.child('live').child($code).child('meta').child('hostUid').val() === auth.uid",
        ".write": "auth != null && root.child('live').child($code).child('meta').child('hostUid').val() === auth.uid",
        "$id": {
          ".write": "auth != null && !data.exists() && root.child('live').child($code).child('players').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['uid', 'total', 't']) && newData.child('uid').val() === auth.uid && newData.child('t').val() === now"
        }
      }
    }
  }
}
