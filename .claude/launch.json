{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "staygo-nextjs-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "staygo-nextjs",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "staygo-out",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3100",
        "-d",
        "staygo-nextjs/out"
      ],
      "port": 3100
    }
  ]
}
